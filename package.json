{
  "name": "convera-workspace",
  "private": true,
  "version": "0.0.22",
  "description": "Convera Workspace",
  "scripts": {
    "start": "pnpm --filter app start",
    "dev:web": "pnpm --filter app dev:web",
    "make": "pnpm --filter app make",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "format:write": "pnpm -r format:write",
    "test": "pnpm --filter app test",
    "test:all": "pnpm --filter app test:all",
    "automation": "pnpm --filter app automation",
    "automation:prepare": "pnpm --filter app automation:prepare",
    "automation:typecheck": "pnpm --filter app automation:typecheck",
    "prepare": "husky",
    "changes": "changeset",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:status": "changeset status",
    "changeset:help": "./scripts/changeset-guide.sh",
    "release": "./scripts/release.sh",
    "release:dry": "pnpm changeset status --verbose",
    "version:sync": "node -e \"const pkg = require('./package.json'); const appPkg = require('./packages/app/package.json'); pkg.version = appPkg.version; require('fs').writeFileSync('./package.json', JSON.stringify(pkg, null, 2) + '\\n');\""
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.1",
  "pnpm": {
    "overrides": {
      "@wdio/native-utils": "2.5.0"
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0"
  }
}
