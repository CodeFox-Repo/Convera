{
  "name": "foxfoxy-workspace",
  "private": true,
  "version": "0.0.1",
  "description": "FoxyChat Workspace",
  "scripts": {
    "start": "cd app && pnpm start",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "format:write": "pnpm -r format:write",
    "test": "pnpm --filter ./app test",
    "test:all": "pnpm --filter ./app test:all",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.1",
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0"
  }
}
