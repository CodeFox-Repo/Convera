{
  "name": "@convera/app",
  "productName": "Convera",
  "version": "0.0.22",
  "description": "Convera - All in one Chat App",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "NODE_ENV=production-development electron-forge start",
    "dev:start": "NODE_ENV=development electron-forge start",
    "dev:web": "tsx scripts/web-bridge-dev.mts",
    "package": "electron-forge package",
    "package:robotjs": "electron-forge package && ./scripts/post-package-robotjs.sh",
    "package:sign": "ENABLE_CODE_SIGNING=true pnpm run package:robotjs && ./scripts/apple-sign.sh",
    "make:robotjs": "pnpm run package:robotjs && electron-forge make --skip-package",
    "make:sign": "ENABLE_CODE_SIGNING=true pnpm run package:sign && electron-forge make --skip-package",
    "make": "pnpm run make:robotjs",
    "publish": "electron-forge publish",
    "postinstall": "test \"$CI\" = \"true\" || pnpm run rebuild:robotjs",
    "rebuild": "electron-rebuild",
    "rebuild:robotjs": "electron-rebuild -f -w @hurdlegroup/robotjs",
    "routes:generate": "tsr generate",
    "routes:watch": "tsr watch",
    "lint": "eslint .",
    "format": "prettier --check . '!template/**' '!.vite/**' '!out/**' '!routeTree.gen.ts'",
    "format:write": "prettier --write . '!template/**' '!.vite/**' '!out/**' '!routeTree.gen.ts'",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test",
    "memory:eval": "tsx scripts/memory-eval.mts",
    "memory:eval:real": "tsx scripts/memory-eval.mts --real",
    "automation": "WDIO_LOG_LEVEL=silent tsx automation/server.ts",
    "automation:prepare": "tsx automation/check-runtime.ts && electron-forge package && tsx automation/prepare-driver.ts",
    "automation:typecheck": "tsc --noEmit -p automation/tsconfig.json"
  },
  "author": "Smal1boy <541898146chen@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.7.0",
    "@electron-forge/maker-deb": "^7.8.0",
    "@electron-forge/maker-dmg": "^7.8.0",
