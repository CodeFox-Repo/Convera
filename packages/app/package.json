{
  "name": "@convera/app",
  "productName": "Convera",
  "version": "0.0.22",
  "description": "Convera - All in one Chat App",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "NODE_ENV=production-development electron-forge start",
    "dev:start": "NODE_ENV=development electron-forge start",
    "package": "electron-forge package",
    "package:sign": "ENABLE_CODE_SIGNING=true pnpm run package && ./scripts/apple-sign.sh",
    "make:sign": "ENABLE_CODE_SIGNING=true pnpm run package:sign && electron-forge make --skip-package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "rebuild": "electron-rebuild",
    "routes:generate": "tsr generate",
    "routes:watch": "tsr watch",
    "lint": "eslint .",
    "format": "prettier --check . '!template/**' '!.vite/**' '!out/**' '!routeTree.gen.ts'",
    "format:write": "prettier --write . '!template/**' '!.vite/**' '!out/**' '!routeTree.gen.ts'",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test"
  },
  "author": "Smal1boy <541898146chen@gmail.com>",
  "license": "MIT",
  "devDependencies": {
